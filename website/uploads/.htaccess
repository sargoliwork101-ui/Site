# اجرای اسکریپت در پوشه آپلودها غیرفعال باشد (امنیت)
Options -Indexes
<IfModule mod_authz_core.c>
  <FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|pl|py|cgi|sh)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar)$">
    Order deny,allow
    Deny from all
  </FilesMatch>
</IfModule>
